<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fx:id="scrollTela" styleClass="scroll-tela" fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.toothtory.controllers.PacienteController">
    <content>
        <VBox fx:id="telaPacientes" styleClass="tela">
            <Label text="Pacientes" styleClass="titulo-pagina"/>
            <HBox spacing="10">
                <TextField fx:id="txtBusca" promptText="Buscar por nome..." HBox.hgrow="ALWAYS"/>
                <Button text="Buscar" styleClass="button-primario" onAction="#buscarPacientes"/>
            </HBox>
            <TableView fx:id="tabelaPacientes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNome" text="NOME"/>
                    <TableColumn fx:id="colEndereco" text="ENDEREÇO" prefWidth="160"/>
                    <TableColumn fx:id="colCpf" text="CPF" prefWidth="120"/>
                    <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="190"/>
                    <TableColumn fx:id="colCelular" text="CELULAR" prefWidth="130"/>
                </columns>
            </TableView>
            <Label text="Cadastro / Edição" styleClass="titulo-secao"/>
            <GridPane hgap="10" vgap="12">
                <Label text="Nome" styleClass="rotulo-campo" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNome" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="CPF" styleClass="rotulo-campo" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCpf" promptText="CPF (obrigatório)" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Endereço" styleClass="rotulo-campo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEndereco" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Email" styleClass="rotulo-campo" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEmail" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Celular" styleClass="rotulo-campo" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCelular" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
            <HBox spacing="10">
                <Button text="Salvar" styleClass="button-primario" onAction="#salvarPaciente"/>
                <Button text="Editar" onAction="#editarPaciente"/>
                <Button text="Limpar" onAction="#limparFormulario"/>
                <Button text="Excluir" styleClass="button-perigo" onAction="#excluirPaciente"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
