<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.toothtory.controllers.ConsultaController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <TableView fx:id="tabelaConsultas">
        <columns>
            <TableColumn fx:id="colId" text="ID"/>
            <TableColumn fx:id="colPaciente" text="Paciente"/>
            <TableColumn fx:id="colDataHora" text="Data/Hora"/>
            <TableColumn fx:id="colProcedimento" text="Procedimento"/>
            <TableColumn fx:id="colValor" text="Valor"/>
            <TableColumn fx:id="colObservacoes" text="Obs."/>
        </columns>
    </TableView>
    <Accordion>
        <panes>
            <TitledPane text="Nova Consulta">
                <VBox spacing="10">
                    <Label text="Paciente:"/>
                    <ComboBox fx:id="comboPaciente" promptText="Selecione o paciente"/>
                    <Label text="Data e Hora:"/>
                    <HBox spacing="10">
                        <DatePicker fx:id="datePicker" promptText="Data"/>
                        <TextField fx:id="txtHora" promptText="HH:mm"/>
                    </HBox>
                    <Label text="Procedimento:"/>
                    <HBox spacing="10">
                        <RadioButton fx:id="rbProcedimentoExistente" text="Existente"/>
                        <RadioButton fx:id="rbProcedimentoManual" text="Manual"/>
                    </HBox>
                    <ComboBox fx:id="comboProcedimento" promptText="Selecione o procedimento"/>
                    <HBox spacing="10">
                        <TextField fx:id="txtNomeProcedimentoManual" promptText="Nome do procedimento"/>
                        <TextField fx:id="txtValorManual" promptText="Valor"/>
                    </HBox>
                    <Label text="Observações:"/>
                    <TextArea fx:id="txtObservacoes" prefHeight="60"/>
                    <HBox spacing="10">
                        <Button text="Salvar" onAction="#salvarConsulta"/>
                        <Button text="Editar" onAction="#editarConsulta"/>
                        <Button text="Limpar" onAction="#limparFormulario"/>
                        <Button text="Excluir" onAction="#excluirConsulta"/>
                    </HBox>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>
</VBox>