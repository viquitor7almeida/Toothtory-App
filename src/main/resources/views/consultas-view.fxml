<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fx:id="scrollTela" styleClass="scroll-tela" fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.toothtory.controllers.ConsultaController">
    <content>
        <VBox styleClass="tela">
            <Label text="Consultas" styleClass="titulo-pagina"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="‹" styleClass="botao-navegacao-mes" minWidth="34" onAction="#mesAnterior"/>
                <Label fx:id="labelMesAno" styleClass="calendario-mes-ano" minWidth="150" alignment="CENTER"/>
                <Button text="›" styleClass="botao-navegacao-mes" minWidth="34" onAction="#mesSeguinte"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Hoje" onAction="#irParaHoje"/>
            </HBox>
            <StackPane fx:id="areaCalendario" styleClass="calendario" prefHeight="400" minHeight="380">
                <GridPane fx:id="gradeDias" hgap="4" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints vgrow="ALWAYS"/>
                        <RowConstraints vgrow="ALWAYS"/>
                        <RowConstraints vgrow="ALWAYS"/>
                        <RowConstraints vgrow="ALWAYS"/>
                        <RowConstraints vgrow="ALWAYS"/>
                        <RowConstraints vgrow="ALWAYS"/>
                    </rowConstraints>
                </GridPane>
            </StackPane>
            <Accordion>
                <panes>
                    <TitledPane fx:id="painelNovaConsulta" text="Nova Consulta">
                        <VBox spacing="12">
                            <Label text="Paciente" styleClass="rotulo-campo"/>
                            <ComboBox fx:id="comboPaciente" promptText="Selecione o paciente" maxWidth="1.7976931348623157E308"/>
                            <Label text="Data e Hora" styleClass="rotulo-campo"/>
                            <HBox spacing="10">
                                <DatePicker fx:id="datePicker" promptText="Data" HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="txtHora" promptText="HH:mm" maxWidth="90"/>
                            </HBox>
                            <Label text="Procedimento" styleClass="rotulo-campo"/>
                            <HBox spacing="10">
                                <RadioButton fx:id="rbProcedimentoExistente" text="Existente"/>
                                <RadioButton fx:id="rbProcedimentoManual" text="Manual"/>
                            </HBox>
                            <ComboBox fx:id="comboProcedimento" promptText="Selecione o procedimento" maxWidth="1.7976931348623157E308"/>
                            <HBox spacing="10">
                                <TextField fx:id="txtNomeProcedimentoManual" promptText="Nome do procedimento" HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="txtValorManual" promptText="Valor" maxWidth="120"/>
                            </HBox>
                            <Label text="Observações" styleClass="rotulo-campo"/>
                            <TextArea fx:id="txtObservacoes" prefHeight="60"/>
                            <HBox spacing="10">
                                <Button text="Salvar" styleClass="button-primario" onAction="#salvarConsulta"/>
                                <Button text="Limpar" onAction="#limparFormulario"/>
                                <Button text="Excluir" styleClass="button-perigo" onAction="#excluirConsulta"/>
                            </HBox>
                        </VBox>
                    </TitledPane>
                </panes>
            </Accordion>
        </VBox>
    </content>
</ScrollPane>
