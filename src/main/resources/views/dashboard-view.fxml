<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox spacing="20" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.toothtory.controllers.DashboardController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <GridPane hgap="20" vgap="20">
        <Label text="Total Pacientes:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="totalPacientesLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Total Procedimentos:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="totalProcedimentosLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Total Consultas:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="totalConsultasLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Faturamento Mês:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="faturamentoMesLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
</VBox>