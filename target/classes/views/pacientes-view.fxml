<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.toothtory.controllers.PacienteController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <HBox spacing="10">
        <TextField fx:id="txtBusca" promptText="Buscar por nome..." HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" onAction="#buscarPacientes"/>
    </HBox>
    <TableView fx:id="tabelaPacientes">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="200"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colCelular" text="Celular" prefWidth="120"/>
        </columns>
    </TableView>
    <Label text="Cadastro/Edição" style="-fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNome" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Endereço:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEndereco" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmail" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Celular:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCelular" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Salvar" onAction="#salvarPaciente"/>
        <Button text="Editar" onAction="#editarPaciente"/>
        <Button text="Excluir" onAction="#excluirPaciente"/>
        <Button text="Limpar" onAction="#limparFormulario"/>
    </HBox>
</VBox>